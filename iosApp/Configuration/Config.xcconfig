// Include real values from Secrets.xcconfig (gitignored, not committed).
// Create iosApp/Configuration/Secrets.xcconfig with your actual values.
#include? "Secrets.xcconfig"

TEAM_ID=

PRODUCT_NAME=Komod
PRODUCT_BUNDLE_IDENTIFIER=com.komod.api.Komod$(TEAM_ID)

// Supabase credentials are now baked into the shared Kotlin binary via BuildKonfig.
// No need to set them here. See local.properties for the source of truth.

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0