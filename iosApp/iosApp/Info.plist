<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>NSCameraUsageDescription</key>
	<string>Komod needs camera access so you can take photos of clothing items.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Komod needs your location to show current weather for outfit generation.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Komod needs photo library access so you can choose existing clothing photos.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Komod needs permission to save photos when you choose to export or store captured images.</string>

	<!-- OAuth callback URL scheme (must match the scheme configured in Supabase and AppModule) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.komod.api</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>komod</string>
			</array>
		</dict>
	</array>
</dict>
</plist>