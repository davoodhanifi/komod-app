<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<!-- Supabase configuration — values injected from Config.xcconfig / Secrets.xcconfig -->
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_PUBLISHABLE_KEY</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>

	<!-- OAuth callback URL scheme (must match the scheme configured in Supabase and AppModule) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.komod.api</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>komod</string>
			</array>
		</dict>
	</array>
</dict>
</plist>